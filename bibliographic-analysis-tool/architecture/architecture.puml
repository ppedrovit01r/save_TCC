@startuml
!pragma layout smetana
skinparam componentStyle rectangle
skinparam defaultTextAlignment center

' --- MAIN APPLICATION ---
component "System Entry Point\n(app.py)" as APP

' --- UTILITIES ---
package "utils" {
    component "exports.py\n(UI Helpers & Safe Run)" as UTILS
}

' --- ABA 1: DATA PREPARATION ---
package "core" {
    component "main.py (Router)" as CORE_MAIN
    component "ingestion.py" as INGESTION
    component "enrichment.py" as ENRICHMENT
    component "export.py" as EXPORT
}

' --- ABA 2: DASHBOARD ---
package "dashboard" {
    component "main.py (Router)" as DASH_MAIN
    component "metrics_general.py" as METRICS_GEN
    component "metrics_impact.py" as METRICS_IMP
    component "metrics_aging.py" as METRICS_AGE
}

' --- ABA 3: FEATURES ---
package "features" {
    component "main.py (Router)" as FEAT_MAIN
    component "network_topology.py" as NET_TOP
    component "semantic_analysis.py" as SEMANTIC
    component "temporal_flow.py" as TEMPORAL
    component "governance.py" as GOVERNANCE
    component "geographic.py" as GEOGRAPHIC
    component "gender.py" as GENDER
    component "prisma_assistant.py" as PRISMA
    component "reviewer_matcher.py" as REV_MATCHER
}

' --- EXTERNAL SERVICES & DATA ---
cloud "OpenAlex API\n(Polite Pool)" as OPENALEX
database "Files\n(.csv, .xlsx, .bib, .ris)" as FILES

' --- LIBRARIES ---
collections "Pandas & NumPy" as PANDAS
component "concurrent.futures" as THREADS
component "requests & cache" as REQ
component "bibtexparser & rispy" as PARSERS
component "Matplotlib / Plotly" as PLOTS
component "NetworkX & Pyvis" as GRAPHS
component "NLTK / NLP Engine" as NLP

' --- ROUTING RELATIONS (APP TO TABS) ---
APP --> CORE_MAIN : Aba 1
APP --> DASH_MAIN : Aba 2
APP --> FEAT_MAIN : Aba 3

' --- INTERNAL MODULE RELATIONS ---
CORE_MAIN --> INGESTION
CORE_MAIN --> ENRICHMENT
CORE_MAIN --> EXPORT
CORE_MAIN --> UTILS

DASH_MAIN --> METRICS_GEN
DASH_MAIN --> METRICS_IMP
DASH_MAIN --> METRICS_AGE
DASH_MAIN --> UTILS

FEAT_MAIN --> NET_TOP
FEAT_MAIN --> SEMANTIC
FEAT_MAIN --> TEMPORAL
FEAT_MAIN --> GOVERNANCE
FEAT_MAIN --> GEOGRAPHIC
FEAT_MAIN --> GENDER
FEAT_MAIN --> PRISMA
FEAT_MAIN --> REV_MATCHER
FEAT_MAIN --> UTILS

' --- DATA FLOW & LIBRARIES RELATIONS ---
FILES --> INGESTION : Upload
EXPORT --> FILES : Download
INGESTION --> PARSERS
INGESTION --> PANDAS

ENRICHMENT --> REQ
ENRICHMENT --> THREADS
REQ --> OPENALEX : REST API Calls

METRICS_GEN --> PANDAS
METRICS_IMP --> PANDAS
METRICS_AGE --> PANDAS
METRICS_GEN --> PLOTS
METRICS_AGE --> PLOTS

NET_TOP --> GRAPHS
SEMANTIC --> NLP
SEMANTIC --> GRAPHS
TEMPORAL --> PLOTS
GEOGRAPHIC --> PLOTS

@enduml